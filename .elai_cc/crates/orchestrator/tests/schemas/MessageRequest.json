{
  "$defs": {
    "CacheControl": {
      "description": "Anthropic-compatible cache_control marker for prompt-prefix caching.\n\nWire shape: {\"type\":\"ephemeral\"} (5-min TTL, the only currently-supported\nkind). Anthropic accepts at most 4 cache_control markers per request;\nB-27 cloud_mode applies them to the system prompt block and the last\nToolDefinition only (2 markers, well under the cap).",
      "properties": {
        "type": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "InputContentBlock": {
      "oneOf": [
        {
          "properties": {
            "cache_control": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CacheControl"
                },
                {
                  "type": "null"
                }
              ]
            },
            "text": {
              "type": "string"
            },
            "type": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "properties": {
            "cache_control": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CacheControl"
                },
                {
                  "type": "null"
                }
              ]
            },
            "id": {
              "type": "string"
            },
            "input": true,
            "name": {
              "type": "string"
            },
            "type": {
              "const": "tool_use",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "name",
            "input"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": {
              "items": {
                "$ref": "#/$defs/ToolResultContentBlock"
              },
              "type": "array"
            },
            "is_error": {
              "type": "boolean"
            },
            "tool_use_id": {
              "type": "string"
            },
            "type": {
              "const": "tool_result",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tool_use_id",
            "content"
          ],
          "type": "object"
        }
      ]
    },
    "InputMessage": {
      "properties": {
        "content": {
          "items": {
            "$ref": "#/$defs/InputContentBlock"
          },
          "type": "array"
        },
        "role": {
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "type": "object"
    },
    "SystemBlock": {
      "description": "One block in the Anthropic system prompt array. The wire array form\n(replacing the legacy `system: \"...\"` string) is required to attach\ncache_control markers.",
      "properties": {
        "cache_control": {
          "anyOf": [
            {
              "$ref": "#/$defs/CacheControl"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "type": "object"
    },
    "ToolChoice": {
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "auto",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "any",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "const": "tool",
              "type": "string"
            }
          },
          "required": [
            "type",
            "name"
          ],
          "type": "object"
        }
      ]
    },
    "ToolDefinition": {
      "properties": {
        "cache_control": {
          "anyOf": [
            {
              "$ref": "#/$defs/CacheControl"
            },
            {
              "type": "null"
            }
          ],
          "description": "Anthropic-only marker. When `Some(CacheControl::ephemeral())`, the\ngateway caches everything UP TO AND INCLUDING this tool's wire\nform for ~5 min, so the next request whose prefix matches reads\nthe cached prefix at ~1/10 the input cost. The OpenAI-compat path\nstrips this field when translating, since OpenAI does not support\nper-block cache control."
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_schema": true,
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "input_schema"
      ],
      "type": "object"
    },
    "ToolResultContentBlock": {
      "oneOf": [
        {
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "json",
              "type": "string"
            },
            "value": true
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "max_tokens": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/InputMessage"
      },
      "type": "array"
    },
    "model": {
      "type": "string"
    },
    "seed": {
      "description": "Phase A6 — determinism plumbing. When `Some(n)`, the sidecar invokes\n`transformers.set_seed(n)` + `torch.manual_seed(n)` immediately before\n`model.generate(...)`, making sampled output reproducible across\nidentical prompts. `None` (the default) preserves pre-A6 behaviour:\nthe wire payload elides the `\"seed\"` key entirely (serde\n`skip_serializing_if`) and the sidecar follows the model's default\nRNG. At `temperature == 0` (greedy decoding) the seed is a no-op.\nType is `u64` so the full transformers seed range is representable.",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "stream": {
      "type": "boolean"
    },
    "system": {
      "items": {
        "$ref": "#/$defs/SystemBlock"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "tool_choice": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolChoice"
        },
        {
          "type": "null"
        }
      ]
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/ToolDefinition"
      },
      "type": [
        "array",
        "null"
      ]
    }
  },
  "required": [
    "model",
    "max_tokens",
    "messages"
  ],
  "title": "MessageRequest",
  "type": "object"
}
