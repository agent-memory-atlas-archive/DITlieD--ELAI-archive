(* C-26 — generic JSON-response EBNF grammar.
 * Constrains sidecar output to a single well-formed JSON value when
 * `DecodingMode::Grammar { ebnf_path = .../json_response.ebnf, .. }` is
 * active.  Mirrors RFC 8259 §3 in EBNF form.  Whitespace tokens are
 * tolerated between any two grammar symbols (the sidecar's grammar
 * engine inserts a `ws*` permissive between adjacent productions).
 *)

json          = ws value ws ;
value         = object | array | string | number | "true" | "false" | "null" ;

object        = "{" ws "}" | "{" ws member ( ws "," ws member )* ws "}" ;
member        = string ws ":" ws value ;

array         = "[" ws "]" | "[" ws value ( ws "," ws value )* ws "]" ;

string        = '"' char* '"' ;
char          = unescaped | "\" escape ;
unescaped     = ? any byte except '"' and '\' and control chars 0x00-0x1F ? ;
escape        = '"' | "\" | "/" | "b" | "f" | "n" | "r" | "t" | "u" hex hex hex hex ;
hex           = digit | "A" | "B" | "C" | "D" | "E" | "F"
                      | "a" | "b" | "c" | "d" | "e" | "f" ;

number        = "-"? int frac? exp? ;
int           = "0" | nonzero digit* ;
frac          = "." digit+ ;
exp           = ("e" | "E") ("+" | "-")? digit+ ;
digit         = "0" | nonzero ;
nonzero       = "1" | "2" | "3" | "4" | "5" | "6" | "7" | "8" | "9" ;

ws            = ( " " | "\t" | "\n" | "\r" )* ;
