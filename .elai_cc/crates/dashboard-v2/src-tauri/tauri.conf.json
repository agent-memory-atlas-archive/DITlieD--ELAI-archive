{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ELAI",
  "version": "0.1.0",
  "identifier": "dev.elai.dashboard-v2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ELAI",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 640,
        "decorations": false,
        "resizable": true,
        "center": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
