{
  "_doc": {
    "what": "Versioned SOURCE OF TRUTH for WHAT ELAI measures: the six proof-spine numbers plus every feature-level benchmark and the e2e-functional lane. It defines the measurement CONTRACT (runner, where the artifact lands, what gates it, whether a lane tag is required); it does NOT hold the measured numbers (those live in the state files under workflow/status/, which are derived/adjudicated and gitignored).",
    "format_choice": "JSON not TOML: this file is machine-read by stdlib-only Python tools (proof_spine_status.py, elai_status_feeder.py) that already speak JSON, every benchmark artifact under .elai_cc/benchmarks/ is JSON, and the two state files are JSON. JSON avoids a tomllib>=3.11 dependency on whatever python the status watcher runs, and TOML's hand-edit advantage is marginal for a tool-maintained structured table. The Rust-consumed configs stay TOML; this Python-consumed registry is JSON for parser symmetry with its consumers.",
    "location_choice": "under .elai_cc/ because that is the ONLY git-versioned path in this repo (everything else is gitignored); the registry is the source of truth so it must be versioned.",
    "boundary": "advisory contract only. This registry NEVER discharges a done-gate. A changeset wiring verdict still comes from the live frozen checkers (wiring-enforcement.md R1-R10); a benchmark PASS still comes from the runner's off-agent artifact + its RRA receipt. The status tools that read this file are Layer-0 advisory caches (elai_status_query.py boundary).",
    "state_files": {
      "proof_spine": "workflow/status/proof-spine-state.json (writer: proof_spine_status.py; the adjudicated 6 numbers + verdicts + lane tags)",
      "benchmarks": "workflow/status/benchmarks-state.json (writer: elai_status_feeder.py; derived each run from this registry + a scan of .elai_cc/benchmarks/)",
      "note": "two files because two single-writers; both are embedded into workflow/status/elai-status.json (proof_spine + benchmarks keys) for the TEIKOKU progress core."
    },
    "row_schema": {
      "id": "stable id (PS-N for spine rows, the bench subcommand name for feature rows)",
      "name": "human name",
      "kind": "proof-spine | feature-bench | e2e-functional",
      "provenance": "the plan unit/letter that defined it",
      "proof_spine": "PS-N if this row IS a spine number (proof-spine kind) or backs one (feature-bench kind); null otherwise",
      "runner": "the real CLI subcommand string, or PLANNED",
      "runner_patterns": "lowercase basename substrings that identify the runner source (proof_spine_status live-scan heuristic; R5-unsound)",
      "artifact_dir": "repo-relative dir where measurement artifacts land, or null",
      "artifact_patterns": "lowercase basename substrings that identify a measurement artifact",
      "gate": "what blocks the LIVE headline number: pod | journal | cloud-dollar | none",
      "lane_tag_required": "true for every row (owner ruling): every number carries a LANE TAG (model id + quant + host) as attribution bookkeeping, not a capability judgment",
      "ledger": "pointer to the dated ledger doc for a landed spine number, or null"
    }
  },
